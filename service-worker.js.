const CACHE_NAME = "oficio-propio-v2";

const ARCHIVOS_BASE = [
  "./",
  "./index.html",
  "./style.css",
  "./manifest.json",
  "./images/oficio-propio-icon-512.png"
];

const ARCHIVOS_OPCIONALES = [
  "./images/oficio-propio-icon.png"
];

self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(async (cache) => {
      // Archivos necesarios para abrir la aplicación.
      await cache.addAll(ARCHIVOS_BASE);

      // El icono adicional es opcional.
      await Promise.all(
        ARCHIVOS_OPCIONALES.map((archivo) =>
          cache.add(archivo).catch(() => {
            console.warn("No se pudo guardar en caché:", archivo);
          })
        )
      );
    })
  );

  self.skipWaiting();
});

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches.keys().then((nombres) =>
      Promise.all(
        nombres
          .filter(
            (nombre) =>
              nombre.startsWith("oficio-propio-") &&
              nombre !== CACHE_NAME
          )
          .map((nombre) => caches.delete(nombre))
      )
    ).then(() => self.clients.claim())
  );
});

self.addEventListener("fetch", (event) => {
  if (event.request.method !== "GET") return;

  const url = new URL(event.request.url);

  // No interceptar solicitudes a otros sitios, como Firebase.
  if (url.origin !== self.location.origin) return;

  event.respondWith(
    caches.open(CACHE_NAME).then(async (cache) => {
      const respuestaGuardada = await cache.match(event.request);

      if (respuestaGuardada) {
        return respuestaGuardada;
      }

      try {
        const respuestaRed = await fetch(event.request);

        if (respuestaRed && respuestaRed.ok) {
          cache.put(event.request, respuestaRed.clone());
        }

        return respuestaRed;
      } catch (error) {
        if (event.request.mode === "navigate") {
          const paginaInicio = await cache.match("./index.html");

          if (paginaInicio) {
            return paginaInicio;
          }
        }

        throw error;
      }
    })
  );
});
